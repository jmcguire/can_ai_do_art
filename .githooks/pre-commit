#!/bin/sh
set -eu

staged_paths=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged_paths" ] || exit 0

run_paths=$(printf '%s\n' "$staged_paths" | awk '/^runs\//')
non_run_paths=$(printf '%s\n' "$staged_paths" | awk '!/^runs\//')

if [ -n "$run_paths" ] && [ -n "$non_run_paths" ]; then
    echo "Roomtone commit guard: do not mix runs with project changes." >&2
    echo "Commit all runs/ changes separately from project changes." >&2
    exit 1
fi
